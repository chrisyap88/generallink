        /* Section label */
        .section-label { font-size: .65rem; font-weight: 700; color: #0D5A8E; letter-spacing: .06em; text-transform: uppercase; margin: .5rem 0 .4rem; padding-bottom: .25rem; border-bottom: 1.5px solid #b2ebf2; }

        /* Grids */
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem .9rem; }
