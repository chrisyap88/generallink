        .lookup-status { display: inline-block; background: #38A169; color: #fff; border-radius: 20px; padding: .08rem .45rem; font-size: .6rem; font-weight: 600; margin-left: .2rem; }

        .admin-assign-box { background: #fff8e1; border-radius: 6px; padding: .4rem .7rem; border-left: 3px solid #D97706; font-size: .7rem; color: #92400e; margin-top: .4rem; display: none; }
